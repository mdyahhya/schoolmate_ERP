{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/schoolmate_logo.jpg", "dest": "/assets/brand/schoolmate_logo.jpg" },
    { "src": "/opensoftwares_logo.png", "dest": "/assets/brand/opensoftwares_logo.png" },
    { "src": "/node_modules/chart.js/dist/chart.umd.js", "dest": "/assets/vendor/chart.umd.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/$1.html" }
  ]
}
